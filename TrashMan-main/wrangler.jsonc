{
  "name": "trashman",
  "compatibility_date": "2026-11-15",
  "main": "./worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GlobalRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GlobalRoom"] }
  ]
}
